{
  "quoteProps": "consistent",
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "lib/",
    "coverage/",
    "references/",
    "examples/*/ios/",
    "examples/*/android/",
    "docs/doc_build/",
    ".yarn/",
    "CHANGELOG.md"
  ]
}
