{
  "$schema": "./node_modules/vrt-android-utils/emulator.config.schema.json",
  "schemaVersion": 1,
  "sdk": {
    "directory": ".android-sdk",
    "commandLineToolsVersion": "15859902",
    "channel": "stable",
    "platform": "36",
    "buildToolsVersion": "36.0.0"
  },
  "emulator": {
    "version": "37.1.11",
    "buildId": "15917651",
    "archiveSha1ByHost": {
      "darwin-arm64": "f22f44948a2b7f0a0103645b9a639290eef92426",
      "darwin-x64": "7df8b0acbe915217dcbb576222bddfcc23e81230",
      "linux-x64": "1b1f78891abf8ec268264356e1365c25519e8379"
    }
  },
  "systemImage": {
    "apiLevel": "36",
    "target": "google_apis_playstore",
    "revision": "7",
