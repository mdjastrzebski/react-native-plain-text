{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["plaintext"],
  "ios": {
    "iosModuleName": "NitroPlainText"
  },
  "android": {
    "androidNamespace": ["plaintext"],
    "androidCxxLibName": "NitroPlainText"
  },
  "autolinking": {
    "NitroPlainText": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroPlainText"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroPlainText"
      }
    }
  },
  "ignorePaths": ["**/node_modules"],
  "gitAttributesGeneratedFlag": true
}
